# Database (shared by all services)
POSTGRES_DB=hygmap
POSTGRES_USER=hygmap_user
POSTGRES_PASSWORD=your_password_here

# API settings
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend settings
VITE_API_URL=http://localhost:8000

# Production overrides (optional; defaults to https://hygmap.space,https://new.hygmap.space in docker-compose.prod.yml)
# CORS_ORIGINS_PROD=https://hygmap.space,https://new.hygmap.space

# API documentation (/docs, /redoc, /openapi.json). On by default, including in
# production — this is a public read-only API and its routes are already in docs/api.md.
# Set to False to turn the interactive pages off.
# ENABLE_DOCS=True

# Reverse-proxy trust for per-IP rate limiting. Set to * in docker-compose.prod.yml,
# which is safe only because that file binds the API to 127.0.0.1. Do not set this if the
# API port is reachable from the internet — clients could forge their own address.
# FORWARDED_ALLOW_IPS=*
