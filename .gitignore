.env
.claude/
# Downloaded AT-HYG source catalogs (athyg_v33-1.csv, athyg_40.csv, ...) — large and
# regenerable from Codeberg, so never committed.
/db/data/athyg_v*
# ...but the derived v3->v4 id map IS committed: db/Dockerfile COPYs it, so excluding it
# breaks a clean-clone build, and it is the durable artifact that outlives the 199MB of
# source it was built from (which AT-HYG deleted from its main branch on 2026-07-25).
!/db/data/athyg_v3_ids.csv
/db/scripts/cns5.dat
/db/scripts/ReadMe.txt
/db/scripts/table*
/vendor/
/hygmap-php/vendor/
# PHPUnit's result cache. Ignoring it was not enough on its own: test-results was already
# tracked, and .gitignore only applies to files git is not already following, so it kept
# showing as modified after every test run. Untracked with `git rm --cached` 2026-07-31.
# The whole directory rather than the one file, since PHPUnit writes others there.
hygmap-php/.phpunit.cache/
/hygmap-frontend/node_modules/
/hygmap-frontend/node_modules/.vite/
node_modules/
*.log
__pycache__/
*.pyc
*.pyo

# Editor swap files
*.swp
*.swo
*~

-rw-rw-r-- 1 jswhitten jswhitten   4502658 Dec 16 19:51 cns5.dat
-rw-rw-r-- 1 jswhitten jswhitten       882 Jan 27 01:55 import_cns5_results.txt
-rw-rw-r-- 1 jswhitten jswhitten     20451 Jan 27 00:55 match_cns5.py
-rw-rw-r-- 1 jswhitten jswhitten     24309 Jan 27 03:14 match_gcns.py
drwxrwxr-x 2 jswhitten jswhitten      4096 Jan 27 03:18 __pycache__
drwxrwxr-x 3 jswhitten jswhitten      4096 Jan 26 14:08 .pytest_cache
-rw-rw-r-- 1 jswhitten jswhitten     10530 Dec 16 19:51 ReadMe.txt
-rw-rw-r-- 1 jswhitten jswhitten        16 Jan 26 02:19 requirements.txt
-rw-rw-r-- 1 jswhitten jswhitten 252128432 Jan 27 01:56 table1c.dat
-rw-rw-r-- 1 jswhitten jswhitten      5941 Jan 27 01:54 table1c.format

# Python virtualenv for the data-import scripts.
#
# db/scripts/.venv was committed in 83bd9662 -- 1,035 files, 26MB -- which bloats every clone
# with platform-specific binaries that are useless to anyone else. Untracked 2026-07-30;
# recreate it with the instructions in db/scripts/README.md.
db/scripts/.venv/
